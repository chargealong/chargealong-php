{
    "name": "chargealong/chargealong",
    "description": "Find EV chargers near a point, plan a road trip through charging stops, and look up how fast electric cars charge. Free and keyless.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ev charger api",
        "ev charging stations",
        "charging station locator",
        "ev trip planner",
        "electric vehicle",
        "ev charging speed",
        "open charge map",
        "australia",
        "php"
    ],
    "homepage": "https://chargealong.io",
    "support": {
        "issues": "https://github.com/chargealong/chargealong-php/issues",
        "source": "https://github.com/chargealong/chargealong-php",
        "docs": "https://chargealong.io/docs/"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-curl": "Needed by the default CurlTransport; supply your own Transport otherwise"
    },
    "autoload": {
        "psr-4": {
            "ChargeAlong\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChargeAlong\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
